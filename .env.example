# CourseDrop — Environment Variables
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Production: APP_ENV=production

# ── URLs ─────────────────────────────────────────────────────────────────────
# The canonical public URL of your site (required for sitemap, canonical tags)
SITE_URL=http://localhost:3000
# Production example: SITE_URL=https://coursedrop.com

# ── Database ─────────────────────────────────────────────────────────────────
# Dev/test:
DATABASE_URL=postgresql+asyncpg://coursedrop:coursedrop@localhost:5432/coursedrop
# Production (Render): DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Test database (set in CI or locally):
# TEST_DATABASE_URL=postgresql+asyncpg://localhost/coursedrop_test

# ── Security ─────────────────────────────────────────────────────────────────
# Must be ≥ 32 chars in production
ADMIN_API_KEY=dev-admin-key-change-me-in-production

# CORS: comma-separated origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Offer Sources ─────────────────────────────────────────────────────────────
# Dev/test: seed,manual
# Production: manual  (seed is blocked in production)
OFFER_SOURCES=seed,manual

# ── Tracking ─────────────────────────────────────────────────────────────────
# The hostname(s) of your Impact affiliate tracking links (comma-separated).
# Dev/test: track.example.test
# Production: copy the hostname from your Impact dashboard tracking link.
# IMPORTANT: The production startup guard will block localhost, .test, .example, .invalid hosts.
ALLOWED_TRACKING_HOSTS=track.example.test

# ── Coursera ─────────────────────────────────────────────────────────────────
COURSERA_CATALOG_URL=https://api.coursera.org/api/courses.v1
COURSERA_SYNC_MAX_COURSES=500

# ── Content ──────────────────────────────────────────────────────────────────
# Max characters for description excerpts (never exposes full description)
DESCRIPTION_EXCERPT_CHARS=300

# Set to true to show course images (confirm license first)
SHOW_COURSE_IMAGES=false

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
SYNC_CATALOG_HOURS=24
DELIST_CHECK_HOURS=24
SYNC_OFFERS_MINUTES=60
REVERIFY_MINUTES=30

# ── Proxy ────────────────────────────────────────────────────────────────────
# Number of trusted proxy hops (for accurate client IP extraction)
TRUSTED_PROXY_COUNT=0

# ── Internal ─────────────────────────────────────────────────────────────────
# Used by Next.js server-side code to reach the API (never exposed to browser)
API_INTERNAL_URL=http://localhost:8000
# Used by browser-side code
NEXT_PUBLIC_API_URL=http://localhost:8000
